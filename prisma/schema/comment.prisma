model Comment {
  id        String        @id @default(uuid())
  content   String        @db.Text
  authorId  String
  postId    String
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  // self relation to catch replay of the comment
  patentId  String?
  parent    Comment?      @relation("commentReplies", fields: [patentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("commentReplies")
  status    CommentStatus @default(APPROVED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([postId])
  @@index([authorId])
  @@map("comments")
}

// enum comment 

enum CommentStatus {
  APPROVED
  REJECT
}